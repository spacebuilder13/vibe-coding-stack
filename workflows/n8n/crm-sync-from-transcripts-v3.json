        "body": "={\n  \"data\": {\n    \"values\": {\n      \"name\": [{ \"first_name\": \"{{$json.name || ''}}\", \"last_name\": \"\", \"full_name\": \"{{$json.name || ''}}\" }],\n      \"name_2\": [{ \"value\": \"{{$json.name || ''}}\" }],\n      \"destination_city\": [{ \"value\": \"{{$json.destination || ''}}\" }],\n      \"time_to_travel\": [{ \"value\": \"{{$json.timeline || ''}}\" }],\n      \"budget_range\": [{ \"value\": \"{{$json.budget_range || ''}}\" }],\n      \"blockers_pain_point\": [{ \"value\": \"{{$json.emotional_blocker || ''}}\" }],\n      \"jtbd\": [{ \"value\": \"{{$json.jobs_to_be_done || ''}}\" }],\n      \"journey_stage\": [{ \"value\": \"{{$json.pipeline_stage || ''}}\" }]\n    }\n  }\n}",
        "options": {}
      },
