      "id": "aa000005-0005-0005-0005-000000000005",
      "name": "Download as Plain Text",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [880, 120],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "ywlAvR4Edjv5N0Aj",
          "name": "Google Drive OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Decode binary output from Google Drive native download\nconst binaryData = $binary?.data;\nlet transcript = '';\nif (binaryData?.data) {\n  transcript = Buffer.from(binaryData.data, 'base64').toString('utf-8').substring(0, 4000);\n}\n\nconst requestBody = JSON.stringify({\n  model: 'claude-haiku-4-5-20251001',\n  max_tokens: 1024,\n  system: 'You are processing call transcripts for WHEN Travel, a travel savings coaching platform. Extract the following as a JSON object only — no preamble, no markdown, no code fences.\\n\\n{\"name\": \"client first name\", \"destination\": \"travel destination or null\", \"timeline\": \"when they want to travel or null\", \"budget_range\": \"total trip budget mentioned or null\", \"emotional_blocker\": \"main fear or hesitation around money or travel\", \"jobs_to_be_done\": \"transformation they want from this\", \"memorable_quote\": \"most emotionally resonant thing they said\", \"pipeline_stage\": \"one of: Discovery Done | Plan Delivered | Active Saver | Milestone Unlocked | Trip Completed\"}\\n\\nStage rules:\\n- Discovery Done: first intake call, no plan yet delivered\\n- Plan Delivered: coach mentions sending a plan\\n- Active Saver: client tracking savings progress\\n- Milestone Unlocked: client has booked flights or accommodation\\n- Trip Completed: trip has already happened',\n  messages: [{ role: 'user', content: transcript }]\n});\n\nreturn { json: { requestBody, filename: $('Loop Docs').item.json.name } };"
      },
      "id": "aa000006-0006-0006-0006-000000000006",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "ANTHROPIC_API_KEY_PLACEHOLDER" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.requestBody }}",
        "options": {}
      },
      "id": "aa000007-0007-0007-0007-000000000007",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1320, 120],
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const responseText = $input.item.json.content[0].text;\nconst cleaned = responseText\n  .replace(/```json\\n?/g, '')\n  .replace(/```\\n?/g, '')\n  .trim();\n\ntry {\n  const extracted = JSON.parse(cleaned);\n  return { json: extracted };\n} catch (e) {\n  return { json: {\n    name: null,\n    destination: null,\n    timeline: null,\n    budget_range: null,\n    emotional_blocker: null,\n    jobs_to_be_done: null,\n    pipeline_stage: 'Insufficient Data',\n    memorable_quote: null\n  }};\n}"
      },
      "id": "aa000008-0008-0008-0008-000000000008",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.attio.com/v2/objects/people/records/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer ATTIO_API_KEY_PLACEHOLDER" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={ \"limit\": 500 }",
        "options": {}
      },
      "id": "aa000009-0009-0009-0009-000000000009",
      "name": "Fetch All People",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1760, 120],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const newData = $('Parse Response').item.json;\nconst allRecords = $('Fetch All People').item.json.data;\nconst filename = $('Loop Docs').item.json.name;\nconst fallbackName = filename.split('_Session')[0].trim();\n\nif (!newData.name && fallbackName) {\n  newData.name = fallbackName;\n}\n\nconst existing = allRecords.find(r =>\n  r.values.name &&\n  r.values.name[0] &&\n  r.values.name[0].full_name === newData.name\n);\n\nif (!existing) {\n  return {\n    json: {\n      isNew: 'true',\n      name: newData.name || fallbackName,\n      destination: newData.destination,\n      timeline: newData.timeline,\n      budget_range: newData.budget_range,\n      emotional_blocker: newData.emotional_blocker,\n      jobs_to_be_done: newData.jobs_to_be_done,\n      memorable_quote: newData.memorable_quote,\n      pipeline_stage: newData.pipeline_stage\n    }\n  };\n}\n\nconst blockers = (existing.values.blockers_pain_point || []).map(b => b.value);\nif (newData.emotional_blocker) blockers.push(newData.emotional_blocker);\n\nconst jtbd = (existing.values.jtbd || []).map(j => j.value);\nif (newData.jobs_to_be_done) jtbd.push(newData.jobs_to_be_done);\n\nconst quotes = (existing.values.memorable_quotes || []).map(q => q.value);\nif (newData.memorable_quote) quotes.push(newData.memorable_quote);\n\nconst values = {};\nif (newData.pipeline_stage) values.journey_stage = [{ value: newData.pipeline_stage }];\nif (newData.timeline) values.time_to_travel = [{ value: newData.timeline }];\nif (newData.budget_range) values.budget_range = [{ value: newData.budget_range }];\nif (newData.destination) values.destination_city = [{ value: newData.destination }];\nif (newData.name) values.name_2 = [{ value: newData.name }];\nif (blockers.length > 0) values.blockers_pain_point = [{ value: blockers.join('\\n\\n') }];\nif (jtbd.length > 0) values.jtbd = [{ value: jtbd.join('\\n\\n') }];\nif (quotes.length > 0) values.memorable_quotes = [{ value: quotes.join('\\n\\n') }];\n\nreturn {\n  json: {\n    isNew: 'false',\n    recordId: existing.id.record_id,\n    body: JSON.stringify({ data: { values } })\n  }\n};"
      },
